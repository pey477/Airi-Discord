# Discord Developer Portal
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set this to register commands only in one test server (instant updates).
DISCORD_GUILD_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# Voice capture safety limits
VOICE_MAX_SECONDS=18
VOICE_SILENCE_MS=1100

# Optional persistent conversation memory (Supabase project dedicated to Airi)
# Keep the secret key private; never use a publishable key here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
