# Discord Developer Portal
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set this to register commands only in one test server (instant updates).
DISCORD_GUILD_ID=

# Groq: chat and multilingual speech-to-text
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Free Edge TTS voice (no API key); Indonesian female voice by default.
EDGE_TTS_VOICE=id-ID-GadisNeural
EDGE_TTS_LANG=id-ID

# Voice capture safety limits
VOICE_MAX_SECONDS=18
VOICE_SILENCE_MS=1100

# Optional persistent conversation memory (Supabase project dedicated to Airi)
# Keep the secret key private; never use a publishable key here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
