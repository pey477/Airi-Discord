{
  "name": "airi-discord",
  "version": "0.1.0",
  "private": true,
  "description": "Airi - multilingual AI Discord companion with text and voice chat.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "register": "tsx src/register-commands.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/audio.test.ts"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.18.0",
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "node-edge-tts": "^1.2.12",
    "openai": "^5.20.0",
    "prism-media": "^1.3.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
